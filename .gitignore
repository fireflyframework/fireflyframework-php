/vendor/
/packages/*/vendor/
/node_modules/
# mkdocs build output
/site/
# local docs build venv (mkdocs-material install; PEP-668 workaround)
/.venv-docs/
# book/ build toolchain venv + generated PDF/EPUB (Python, not part of the PHP toolchain)
/book/.venv/
/book/dist/
/book/.pytest_cache/
/book/**/__pycache__/
# library monorepo: do not commit the root lock
composer.lock
.phpunit.result.cache
.phpunit.cache/
/.php-cs-fixer.cache
/.phpstan-cache/
/.deptrac.cache
# Never commit design docs (specs/plans) per project policy
/docs/superpowers/
# Subagent-driven-development scratch (ledger + review packages)
/.superpowers/
.DS_Store
# IDE / editor
/.idea/
/.vscode/
*.swp
# env files (never commit real env; .env.example is allowed by the guard)
.env
.env.*
!.env.example
# OS cruft
Thumbs.db
# tool caches / logs / coverage
*.log
/coverage/
/.claude/
