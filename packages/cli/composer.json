{
    "name": "firefly/cli",
    "description": "LaraFly CLI: the developer-experience console — firefly:cache (compile all app manifests + emit #[Transactional] proxies to bootstrap/cache/firefly for a zero-reflection boot), firefly:clear, firefly:about + actuator-over-CLI (routes/health/metrics), the make:firefly-* generator family, and thin serve/db passthroughs.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        {
            "name": "Firefly Software Solutions Inc.",
            "homepage": "https://github.com/fireflyframework"
        }
    ],
    "keywords": [
        "firefly",
        "laravel",
        "cli"
    ],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/cli"
    },
    "require": {
        "php": "^8.3",
        "firefly/actuator": "^26.09",
        "firefly/autoconfigure": "^26.09",
        "firefly/config": "^26.09",
        "firefly/container": "^26.09",
        "firefly/context": "^26.09",
        "firefly/cqrs": "^26.09",
        "firefly/data": "^26.09",
        "firefly/eda": "^26.09",
        "firefly/kernel": "^26.09",
        "firefly/messaging": "^26.09",
        "firefly/observability": "^26.09",
        "firefly/scheduling": "^26.09",
        "firefly/security": "^26.09",
        "firefly/validation": "^26.09",
        "firefly/web": "^26.09",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Cli\\CliServiceProvider",
                "Firefly\\Cli\\Boot\\FireflyCacheServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "26.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Firefly\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\Cli\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
