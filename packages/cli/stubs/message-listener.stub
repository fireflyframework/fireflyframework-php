/**
 * #[MessageListener] marks a public method of a BEAN, so the class itself carries a #[Component] stereotype:
 * that is what puts it in the component manifest, and only a managed bean gets constructor autowiring,
 * #[Value] injection and bean post-processing when MessageListenerWiringPass resolves it per delivery.
 */
#[Component]
final class {{ class }}
{
    /**
     * Replace the topic with the broker topic this listener consumes.
     */
    #[MessageListener('{{ class }}')]
    public function onMessage(Message $message): void
    {
    }
}
