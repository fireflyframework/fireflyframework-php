{
    "name": "firefly/config",
    "description": "LaraFly configuration: Spring-style profiles, typed config access, and #[ConfigProperties] DTO binding over Illuminate's config repository.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        { "name": "Firefly Software Solutions Inc.", "homepage": "https://github.com/fireflyframework" }
    ],
    "keywords": ["firefly", "laravel", "configuration"],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/config"
    },
    "require": {
        "php": "^8.3",
        "firefly/kernel": "*@dev",
        "firefly/container": "*@dev",
        "illuminate/config": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "symfony/expression-language": "^8.0"
    },
    "extra": {
        "branch-alias": { "dev-main": "26.x-dev" }
    },
    "autoload": {
        "psr-4": { "Firefly\\Config\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Firefly\\Config\\Tests\\": "tests/" }
    },
    "minimum-stability": "stable",
    "config": { "sort-packages": true }
}
