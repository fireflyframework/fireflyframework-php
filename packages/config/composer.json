{
    "name": "firefly/config",
    "description": "LaraFly configuration: Spring-style profiles, typed config access, and #[ConfigProperties] DTO binding over Illuminate's config repository.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "firefly/kernel": "*@dev",
        "firefly/container": "*@dev",
        "illuminate/config": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "symfony/expression-language": "^8.0"
    },
    "autoload": {
        "psr-4": { "Firefly\\Config\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Firefly\\Config\\Tests\\": "tests/" }
    },
    "minimum-stability": "stable",
    "config": { "sort-packages": true }
}
