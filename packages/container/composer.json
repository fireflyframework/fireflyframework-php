{
    "name": "firefly/container",
    "description": "LaraFly dependency injection: PHP 8 attribute stereotypes, component scanning, and a cached manifest over Illuminate\\Container.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "firefly/kernel": "*@dev",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "symfony/expression-language": "^8.0"
    },
    "autoload": {
        "psr-4": { "Firefly\\Container\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Firefly\\Container\\Tests\\": "tests/" }
    },
    "minimum-stability": "stable",
    "config": { "sort-packages": true }
}
