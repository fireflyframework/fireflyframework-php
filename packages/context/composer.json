{
    "name": "firefly/context",
    "description": "LaraFly boot engine: the FireflyKernel ordered boot pipeline, conditional evaluation, bean post-processing, lifecycle callbacks, and application events.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "firefly/config": "*@dev",
        "firefly/container": "*@dev",
        "firefly/kernel": "*@dev",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": { "psr-4": { "Firefly\\Context\\": "src/" } },
    "autoload-dev": { "psr-4": { "Firefly\\Context\\Tests\\": "tests/" } },
    "minimum-stability": "stable",
    "config": { "sort-packages": true }
}
