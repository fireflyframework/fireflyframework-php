{
    "name": "firefly/eda-kafka",
    "description": "LaraFly eda Kafka adapter: a KafkaEventPublisher + consumer over the OPTIONAL ext-rdkafka (suggest + extension_loaded guard — never a hard require), auto-configured behind firefly.eda.provider=kafka, with a DLT topic for exhausted retries and a KafkaHealthIndicator.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        {
            "name": "Firefly Software Solutions Inc.",
            "homepage": "https://github.com/fireflyframework"
        }
    ],
    "keywords": [
        "firefly",
        "laravel",
        "kafka"
    ],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/eda-kafka"
    },
    "require": {
        "php": "^8.3",
        "firefly/actuator": "^26.09",
        "firefly/autoconfigure": "^26.09",
        "firefly/config": "^26.09",
        "firefly/container": "^26.09",
        "firefly/context": "^26.09",
        "firefly/eda": "^26.09",
        "firefly/kernel": "^26.09",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "suggest": {
        "ext-rdkafka": "Required ONLY to activate the Kafka adapter (firefly.eda.provider=kafka). Needs librdkafka >= 1.5.3. Absent = the adapter is inert; the default gate + non-Kafka consumers never need it."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Eda\\Kafka\\EdaKafkaServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "26.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Firefly\\Eda\\Kafka\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\Eda\\Kafka\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
