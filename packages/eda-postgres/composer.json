{
    "name": "firefly/eda-postgres",
    "description": "LaraFly eda Postgres adapter: a PostgresEventPublisher backed by a GENUINE same-transaction firefly_eda_outbox table (the outbox row commits atomically with the aggregate), an in-process LISTEN/NOTIFY + poll consumer that claims committed PENDING rows (SELECT ... FOR UPDATE SKIP LOCKED), drives #[EventListener] handlers, and marks them PUBLISHED, plus an OPTIONAL firefly:outbox:relay command that forwards PENDING rows to a distinct downstream broker. Auto-configured behind firefly.eda.provider=postgres.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        {
            "name": "Firefly Software Solutions Inc.",
            "homepage": "https://github.com/fireflyframework"
        }
    ],
    "keywords": [
        "firefly",
        "laravel",
        "outbox",
        "postgres"
    ],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/eda-postgres"
    },
    "require": {
        "php": "^8.3",
        "ext-pdo_pgsql": "*",
        "firefly/actuator": "26.07.17",
        "firefly/autoconfigure": "26.07.17",
        "firefly/config": "26.07.17",
        "firefly/container": "26.07.17",
        "firefly/context": "26.07.17",
        "firefly/cqrs": "26.07.17",
        "firefly/data": "26.07.17",
        "firefly/domain": "26.07.17",
        "firefly/eda": "26.07.17",
        "firefly/kernel": "26.07.17",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Eda\\Postgres\\EdaPostgresServiceProvider",
                "Firefly\\Eda\\Postgres\\EdaPostgresBootServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "26.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Firefly\\Eda\\Postgres\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\Eda\\Postgres\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
