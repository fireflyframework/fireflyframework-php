{
    "name": "firefly/eda-rabbitmq",
    "description": "LaraFly eda RabbitMQ adapter: a RabbitMqEventPublisher + long-running consumer over php-amqplib (AMQP 0-9-1), auto-configured behind firefly.eda.provider=rabbitmq, with a DLX for exhausted retries and a RabbitMqHealthIndicator.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        {
            "name": "Firefly Software Solutions Inc.",
            "homepage": "https://github.com/fireflyframework"
        }
    ],
    "keywords": [
        "firefly",
        "laravel",
        "rabbitmq"
    ],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/eda-rabbitmq"
    },
    "require": {
        "php": "^8.3",
        "firefly/actuator": "^26.09",
        "firefly/autoconfigure": "^26.09",
        "firefly/config": "^26.09",
        "firefly/container": "^26.09",
        "firefly/context": "^26.09",
        "firefly/eda": "^26.09",
        "firefly/kernel": "^26.09",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Eda\\Rabbitmq\\EdaRabbitmqServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "26.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Firefly\\Eda\\Rabbitmq\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\Eda\\Rabbitmq\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
