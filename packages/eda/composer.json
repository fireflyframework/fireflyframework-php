{
    "name": "firefly/eda",
    "description": "LaraFly event-driven architecture: an EventPublisher broker-bus port with in-memory and Laravel-queue adapters, an EventEnvelope + JSON serializer seam, a #[EventListener] scanner/manifest wired at boot, and a linear-backoff retry/dead-letter helper.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        {
            "name": "Firefly Software Solutions Inc.",
            "homepage": "https://github.com/fireflyframework"
        }
    ],
    "keywords": [
        "firefly",
        "laravel",
        "event-driven"
    ],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/eda"
    },
    "require": {
        "php": "^8.3",
        "firefly/autoconfigure": "26.07.17",
        "firefly/config": "26.07.17",
        "firefly/container": "26.07.17",
        "firefly/context": "26.07.17",
        "firefly/kernel": "26.07.17",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Eda\\EdaServiceProvider",
                "Firefly\\Eda\\EdaWiringProvider",
                "Firefly\\Eda\\EdaConsumerServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "26.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Firefly\\Eda\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\Eda\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
