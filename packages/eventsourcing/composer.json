{
    "name": "firefly/eventsourcing",
    "description": "LaraFly event sourcing: an EventStore port (memory, database) with optimistic concurrency on UNIQUE(aggregate_id, aggregate_version) and a commit-ordered global stream safe under concurrent appenders on PostgreSQL, MySQL, MariaDB, SQL Server and SQLite; event-sourced aggregates and a snapshot-aware repository; snapshot stores; upcasters; projections with checkpoints and a DistributedLock lease; same-transaction publishing through the eda-database outbox; and an event-sourced orchestration execution store.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        {
            "name": "Firefly Software Solutions Inc.",
            "homepage": "https://github.com/fireflyframework"
        }
    ],
    "keywords": [
        "firefly",
        "laravel",
        "event-sourcing",
        "cqrs",
        "projections",
        "ddd"
    ],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/eventsourcing"
    },
    "require": {
        "php": "^8.5.12",
        "firefly/actuator": "*@dev",
        "firefly/autoconfigure": "*@dev",
        "firefly/config": "*@dev",
        "firefly/container": "*@dev",
        "firefly/context": "*@dev",
        "firefly/data": "*@dev",
        "firefly/domain": "*@dev",
        "firefly/eda": "*@dev",
        "firefly/eda-database": "*@dev",
        "firefly/kernel": "*@dev",
        "firefly/orchestration": "*@dev",
        "firefly/resilience": "*@dev",
        "firefly/scheduling": "*@dev",
        "illuminate/console": "^13.38",
        "illuminate/container": "^13.38",
        "illuminate/contracts": "^13.38",
        "illuminate/database": "^13.38",
        "illuminate/log": "^13.38",
        "illuminate/support": "^13.38",
        "psr/log": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\EventSourcing\\EventSourcingServiceProvider",
                "Firefly\\EventSourcing\\EventSourcingWiringProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "26.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Firefly\\EventSourcing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\EventSourcing\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
