{
    "name": "firefly/feature-flags",
    "description": "LaraFly feature flags on OpenFeature: flagd documents evaluated in-process, layered config/file/http/store sources, #[FeatureFlag] gating, a writable store with an audit trail and a sync endpoint.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        {
            "name": "Firefly Software Solutions Inc.",
            "homepage": "https://github.com/fireflyframework"
        }
    ],
    "keywords": [
        "firefly",
        "laravel",
        "feature-flags",
        "openfeature",
        "flagd"
    ],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/feature-flags"
    },
    "require": {
        "php": "^8.3",
        "firefly/actuator": "*@dev",
        "firefly/autoconfigure": "*@dev",
        "firefly/config": "*@dev",
        "firefly/container": "*@dev",
        "firefly/context": "*@dev",
        "firefly/data": "*@dev",
        "firefly/kernel": "*@dev",
        "firefly/resilience": "*@dev",
        "firefly/web": "*@dev",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "open-feature/sdk": "^2.3",
        "psr/log": "^3.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\FeatureFlags\\FeatureFlagsServiceProvider",
                "Firefly\\FeatureFlags\\FeatureFlagsWiringProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "26.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Firefly\\FeatureFlags\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\FeatureFlags\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
