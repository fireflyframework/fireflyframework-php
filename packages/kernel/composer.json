{
    "name": "firefly/kernel",
    "description": "LaraFly kernel: framework-agnostic lifecycle contract, exception taxonomy, and RFC-7807 error model.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Firefly\\Kernel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\Kernel\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
