{
    "name": "firefly/messaging",
    "description": "LaraFly raw-bytes messaging: a MessageBrokerPort with in-memory and Laravel-queue adapters, a broker-agnostic #[MessageListener] (topic/group/retries/retryDelay/deadLetterTopic) scanned into a compiled manifest and wired at boot, and a bytes-aware retry/dead-letter helper.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "firefly/autoconfigure": "*@dev",
        "firefly/config": "*@dev",
        "firefly/container": "*@dev",
        "firefly/context": "*@dev",
        "firefly/kernel": "*@dev",
        "illuminate/bus": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Messaging\\MessagingServiceProvider",
                "Firefly\\Messaging\\MessagingWiringProvider"
            ]
        }
    },
    "autoload": { "psr-4": { "Firefly\\Messaging\\": "src/" } },
    "autoload-dev": { "psr-4": { "Firefly\\Messaging\\Tests\\": "tests/" } },
    "minimum-stability": "stable",
    "config": { "sort-packages": true }
}
