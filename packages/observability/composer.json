{
    "name": "firefly/observability",
    "description": "LaraFly observability: a first-party pure-PHP MeterRegistry (counter/gauge/timer) with Prometheus 0.0.4 text exposition and a Micrometer-JSON /metrics endpoint, HTTP request auto-instrumentation, the real MeterRegistry-backed CqrsMetrics recorder, a resilience circuit-breaker gauge, process metrics, and a Tracer port (NoOp; OTel drops in at SP-7). Top-of-stack, gated on a MeterRegistry bean.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "firefly/actuator": "*@dev",
        "firefly/autoconfigure": "*@dev",
        "firefly/config": "*@dev",
        "firefly/container": "*@dev",
        "firefly/context": "*@dev",
        "firefly/cqrs": "*@dev",
        "firefly/kernel": "*@dev",
        "firefly/resilience": "*@dev",
        "firefly/web": "*@dev",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Observability\\ObservabilityServiceProvider",
                "Firefly\\Observability\\ObservabilityWiringProvider"
            ]
        }
    },
    "autoload": { "psr-4": { "Firefly\\Observability\\": "src/" } },
    "autoload-dev": { "psr-4": { "Firefly\\Observability\\Tests\\": "tests/" } },
    "minimum-stability": "stable",
    "config": { "sort-packages": true }
}
