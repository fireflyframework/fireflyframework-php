{
    "name": "firefly/observability",
    "description": "LaraFly observability: a first-party pure-PHP MeterRegistry (counter/gauge/timer) with Prometheus 0.0.4 text exposition and a Micrometer-JSON /metrics endpoint, HTTP request auto-instrumentation, the real MeterRegistry-backed CqrsMetrics recorder, a resilience circuit-breaker gauge, process metrics, and a Tracer port (NoOp; OTel drops in at SP-7). Top-of-stack, gated on a MeterRegistry bean.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        {
            "name": "Firefly Software Solutions Inc.",
            "homepage": "https://github.com/fireflyframework"
        }
    ],
    "keywords": [
        "firefly",
        "laravel",
        "metrics",
        "prometheus"
    ],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/observability"
    },
    "require": {
        "php": "^8.3",
        "firefly/actuator": "26.07.17",
        "firefly/autoconfigure": "26.07.17",
        "firefly/config": "26.07.17",
        "firefly/container": "26.07.17",
        "firefly/context": "26.07.17",
        "firefly/cqrs": "26.07.17",
        "firefly/kernel": "26.07.17",
        "firefly/resilience": "26.07.17",
        "firefly/web": "26.07.17",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Observability\\ObservabilityServiceProvider",
                "Firefly\\Observability\\ObservabilityWiringProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "26.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Firefly\\Observability\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\Observability\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
