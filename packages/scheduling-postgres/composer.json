{
    "name": "firefly/scheduling-postgres",
    "description": "LaraFly scheduling Postgres adapter: PgAdvisoryLock, a DistributedLock backend over Postgres session-level advisory locks (pg_try_advisory_lock / pg_advisory_unlock), auto-configured behind firefly.scheduling.lock.provider=postgres.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "firefly/autoconfigure": "*@dev",
        "firefly/config": "*@dev",
        "firefly/container": "*@dev",
        "firefly/context": "*@dev",
        "firefly/kernel": "*@dev",
        "firefly/scheduling": "*@dev",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Scheduling\\Postgres\\SchedulingPostgresServiceProvider"
            ]
        }
    },
    "autoload": { "psr-4": { "Firefly\\Scheduling\\Postgres\\": "src/" } },
    "autoload-dev": { "psr-4": { "Firefly\\Scheduling\\Postgres\\Tests\\": "tests/" } },
    "minimum-stability": "stable",
    "config": { "sort-packages": true }
}
