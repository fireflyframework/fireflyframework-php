{
    "name": "firefly/security-oauth2-server",
    "description": "LaraFly OAuth2 authorization server: an OAuth 2.1 / OpenID Connect 1.0 provider inside the application — registered clients, authorization code + PKCE with consent, client credentials, refresh rotation, RS256/ES256 JWT access tokens, JWKS, RFC 8414 metadata, introspection, revocation, userinfo and RP-initiated logout — on firefly/security's session, login page, entry point and PasswordEncoder.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/fireflyframework/fireflyframework-php",
    "authors": [
        {
            "name": "Firefly Software Solutions Inc.",
            "homepage": "https://github.com/fireflyframework"
        }
    ],
    "keywords": [
        "firefly",
        "laravel",
        "oauth2",
        "oidc",
        "authorization-server"
    ],
    "support": {
        "issues": "https://github.com/fireflyframework/fireflyframework-php/issues",
        "source": "https://github.com/fireflyframework/fireflyframework-php/tree/main/packages/security-oauth2-server"
    },
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0",
        "firefly/actuator": "*@dev",
        "firefly/autoconfigure": "*@dev",
        "firefly/config": "*@dev",
        "firefly/container": "*@dev",
        "firefly/context": "*@dev",
        "firefly/data": "*@dev",
        "firefly/kernel": "*@dev",
        "firefly/resilience": "*@dev",
        "firefly/scheduling": "*@dev",
        "firefly/security": "*@dev",
        "firefly/web": "*@dev",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/session": "^13.0",
        "illuminate/support": "^13.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "firefly/openapi": "*@dev"
    },
    "suggest": {
        "firefly/openapi": "The OpenAPI document this server contributes its `authorizationCode` flow to, so a generated client can complete it (AuthorizationServerSchemeContributor)."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Security\\OAuth2\\Server\\SecurityOAuth2ServerServiceProvider",
                "Firefly\\Security\\OAuth2\\Server\\SecurityOAuth2ServerWiringProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "26.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Firefly\\Security\\OAuth2\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firefly\\Security\\OAuth2\\Server\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
