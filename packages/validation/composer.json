{
    "name": "firefly/validation",
    "description": "LaraFly validation: a validate() port over Illuminate\\Validation, financial-domain Rule objects, and a ValidationAutoConfiguration that backs off when the app supplies its own Validator.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "firefly/autoconfigure": "*@dev",
        "firefly/container": "*@dev",
        "firefly/context": "*@dev",
        "firefly/kernel": "*@dev",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firefly\\Validation\\ValidationServiceProvider"
            ]
        }
    },
    "autoload": { "psr-4": { "Firefly\\Validation\\": "src/" } },
    "autoload-dev": { "psr-4": { "Firefly\\Validation\\Tests\\": "tests/" } },
    "minimum-stability": "stable",
    "config": { "sort-packages": true }
}
