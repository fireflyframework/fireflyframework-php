includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:
    level: max
    # Analyse at the composer floor, PHP 8.5.12.
    phpVersion: 80512
    universalObjectCratesClasses:
        - Pest\Mixins\Expectation
    paths:
        - packages
        - tests
        - samples/lumen/src
        - samples/lumen/tests
    excludePaths:
        - packages/*/vendor
    tmpDir: .phpstan-cache
